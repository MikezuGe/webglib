      "^/test/(.*)$",
      "^../(.*)$",
      "^./(.*)$"
    ],
    "importOrderSeparation": true,
    "importOrderSortSpecifiers": true
  },
  "devDependencies": {
    "@parcel/resolver-glob": "^2.12.0",
    "@parcel/transformer-inline-string": "^2.12.0",
    "@trivago/prettier-plugin-sort-imports": "^4.3.0",
    "@types/jest": "^29.5.12",
    "@webgpu/types": "^0.1.40",
    "eslint": "^8.57.0",
