{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Model",
  "$comment": "A model",
  "type": "object",
  "required": ["meshes"],
  "additionalProperties": false,
  "properties": {
    "meshes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$comment": "URL to the mesh",
        "type": "string"
      }
    }
  }
}
